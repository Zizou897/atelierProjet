# Read-only API used to display public-site CTAMS quote requests.
CTAMS_QUOTES_API_URL=https://ctams.net/internal-api/quote-requests/
# Must match INTERNAL_API_KEY configured on the CTAMS public site.
CTAMS_QUOTES_API_KEY=

# CTAMS contact messages GET endpoint; reuses CTAMS_QUOTES_API_KEY by default.
CTAMS_CONTACT_MESSAGES_API_URL=https://ctams.net/internal-api/contact-messages/
